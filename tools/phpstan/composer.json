{
    "name": "bode/tools-phpstan",
    "description": "Isolated PHPStan toolchain (its dependency tree conflicts with magento-coding-standard)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.15"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
