{
    "name": "bode/telemetry-harness",
    "description": "Local harness that runs the Bode modules against stub Magento classes and a real OpenTelemetry SDK",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "open-telemetry/api": "^1.4",
        "open-telemetry/sdk": "^1.4",
        "open-telemetry/exporter-otlp": "^1.3",
        "open-telemetry/sem-conv": "^1.30",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "php-http/guzzle7-adapter": "^1.1",
        "monolog/monolog": "^3.9"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
