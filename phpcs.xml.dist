<?xml version="1.0"?>
<ruleset name="Bode" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="tools/quality/vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>Coding standard for the Bode packages: Magento 2 standard + PHP compatibility.</description>

    <file>packages</file>
    <file>tests</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php,phtml"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <rule ref="Magento2"/>

    <!-- Minimum supported PHP up to the highest Magento 2.4.9 supports -->
    <config name="testVersion" value="8.3-"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
